{
  "manifest_version": 3,
  "name": "sereno for GitHub",
  "short_name": "sereno",
  "version": "0.3.0",
  "description": "Pay GitHub developers by username, fund bounties that pay on merge, spend with a browser key. Not affiliated with GitHub.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "sereno",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "alarms"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://sereno-production.up.railway.app/*",
    "https://happy-curiosity-production-7074.up.railway.app/*",
    "https://sepolia.base.org/*",
    "https://base-sepolia-rpc.publicnode.com/*",
    "https://base-sepolia.drpc.org/*",
    "https://sepolia-rollup.arbitrum.io/*",
    "https://arbitrum-sepolia-rpc.publicnode.com/*",
    "https://arbitrum-sepolia.drpc.org/*",
    "https://ethereum-sepolia-rpc.publicnode.com/*",
    "https://sepolia.gateway.tenderly.co/*",
    "https://0xrpc.io/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://sereno-eth.vercel.app/*",
      "http://localhost/*"
    ]
  }
}
