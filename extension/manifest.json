{
  "manifest_version": 3,
  "name": "Sereno for GitHub",
  "short_name": "Sereno",
  "version": "0.1.0",
  "description": "Pay any developer from their GitHub profile, fund issue bounties that pay out on merge, and tip commit and PR authors.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Sereno", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://github.com/*"], "js": ["content.js"], "run_at": "document_end" }],
  "host_permissions": [
    "https://sepolia.base.org/*",
    "https://base-sepolia-rpc.publicnode.com/*",
    "https://base-sepolia.drpc.org/*",
    "https://sepolia-rollup.arbitrum.io/*",
    "https://arbitrum-sepolia-rpc.publicnode.com/*",
    "https://arbitrum-sepolia.drpc.org/*",
    "https://happy-curiosity-production-7074.up.railway.app/*",
    "https://api.github.com/*"
  ]
}
